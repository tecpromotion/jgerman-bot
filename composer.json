{
    "name": "joomlagerman/jgerman-bot",
    "type": "project",
    "description": "The scripts powering the jgerman-bot",
    "homepage": "https://github.com/joomlagerman/jgerman-bot",
    "config": {
        "optimize-autoloader": true,
        "platform": {
            "php": "8.5.0"
        }
    },
    "require": {
        "php": "^8.5",
        "joomla/github": "^4.0",
        "joomla/http": "^4.0",
        "joomla/registry": "^4.0",
        "joomla/uri": "^4.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0",
        "phpstan/phpstan": "^2.0",
        "friendsofphp/php-cs-fixer": "^3.60"
    },
    "autoload": {
        "psr-4": {
            "joomlagerman\\Helper\\": "src/",
            "joomlagerman\\Enum\\": "src/Enum/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "joomlagerman\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "stan": "phpstan analyse",
        "cs-check": "php-cs-fixer fix --dry-run --diff",
        "cs-fix": "php-cs-fixer fix"
    }
}
